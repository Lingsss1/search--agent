+from unittest.mock import Mock
+
+from areal.trainer.rl_trainer import PPOTrainer
+
+
+def test_close_tolerates_partially_initialized_trainer(monkeypatch):
+    """A constructor failure must still release controllers that already exist."""
+    trainer = object.__new__(PPOTrainer)
+    trainer.actor = Mock()
+    save = Mock()
+    monkeypatch.setattr("areal.trainer.rl_trainer.perf_tracer.save", save)
+
+    trainer.close()
+
+    trainer.actor.destroy.assert_called_once_with()
+    save.assert_called_once_with(force=True)
