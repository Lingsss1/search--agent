+def reduce_masked_loss(
+    values: torch.Tensor,
+    active_mask: torch.Tensor,
+    normalization_mask: torch.Tensor,
+    *,
+    reduction: str,
+    cu_seqlens: torch.Tensor | None = None,
+) -> torch.Tensor:
+    """Reduce token losses with either token- or sequence-equal weighting.
+
+    ``active_mask`` may be narrowed by rejection sampling. The denominator uses
+    ``normalization_mask`` so filtering tokens does not inflate the survivors.
+    """
