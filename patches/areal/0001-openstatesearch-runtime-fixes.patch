+def _merge_local_worker_stats(worker_stats: list[dict[str, Any]]) -> dict[str, Any]:
+    """Merge statistics exported independently by DP-head workers.
+
+    This deliberately performs no torch.distributed collectives.  Statistics
+    are observability data and must not be able to wedge a completed optimizer
+    step.  Tracker scalar values carry ``__count`` companions and are merged
+    exactly; tensor averages are macro-averaged across ranks, while sums and
+    extrema retain their natural reductions.
+    """
+    if not worker_stats:
+        return {}
+
+    result: dict[str, Any] = {}
+    keys = sorted({key for stats in worker_stats for key in stats})
+    for key in keys:
+        values = [stats[key] for stats in worker_stats if key in stats]
+        numeric = [
+            float(value)
+            for value in values
+            if isinstance(value, int | float) and math.isfinite(float(value))
+        ]
+        if not numeric:
+            result[key] = values[0]
+            continue
+
+        if key.endswith("__count"):
+            result[key] = int(sum(numeric))
+        elif key.endswith("/min"):
+            result[key] = min(numeric)
+        elif key.endswith("/max"):
+            result[key] = max(numeric)
+        elif key.endswith("/avg"):
+            result[key] = sum(numeric) / len(numeric)
+        elif f"{key}__count" in keys:
+            weighted_sum = 0.0
+            total_count = 0.0
+            for stats in worker_stats:
+                if key not in stats:
+                    continue
+                count = float(stats.get(f"{key}__count", 0))
+                weighted_sum += float(stats[key]) * count
+                total_count += count
+            result[key] = weighted_sum / total_count if total_count else 0.0
+        else:
+            # Unsuffixed values without a scalar count are tracker SUMs (most
+            # commonly n_seqs/n_tokens denominators).
+            result[key] = sum(numeric)
+    return result
