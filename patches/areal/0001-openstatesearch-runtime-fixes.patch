+def count_masked_sequences(
+    loss_mask: torch.Tensor,
+    cu_seqlens: torch.Tensor | None = None,
+) -> torch.Tensor:
+    """Count sequences containing at least one active loss token."""
+
+    if loss_mask.ndim == 1:
+        if cu_seqlens is None:
+            raise ValueError("cu_seqlens is required for packed sequence reduction")
+        lengths = (cu_seqlens[1:] - cu_seqlens[:-1]).to(device=loss_mask.device)
+        sequence_idx = torch.arange(
+            lengths.numel(), device=loss_mask.device
+        ).repeat_interleave(lengths)
+        counts = torch.zeros(
+            lengths.numel(), device=loss_mask.device, dtype=torch.int64
+        ).scatter_add_(0, sequence_idx, loss_mask.to(torch.int64))
+        return counts.gt(0).sum()
+    if loss_mask.ndim == 2:
