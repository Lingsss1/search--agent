+def _stage_disk_weights_from_ssh(meta: WeightUpdateMeta) -> None:
+    """Mirror a completed disk update when rollout runs on another machine.
+
+    AReaL's disk LoRA updater normally assumes a shared filesystem.  For a Ray
+    cluster without NFS, ``AREAL_DISK_WEIGHT_SOURCE`` can name the SSH source
+    (for example ``root@10.0.0.1``).  The actor's name-resolve notification is
+    emitted only after the adapter has been completely written, so pulling here
+    preserves the same save-before-load ordering as a shared mount.
+    """
+    assert meta.path is not None
+    if meta.use_lora:
+        required = (
+            os.path.join(meta.path, "adapter_config.json"),
+            os.path.join(meta.path, "adapter_model.safetensors"),
+        )
+        if all(os.path.isfile(path) for path in required):
+            return
+    elif os.path.isdir(meta.path) and os.listdir(meta.path):
+        return
+
+    source = os.environ.get("AREAL_DISK_WEIGHT_SOURCE", "").strip().rstrip(":")
+    if not source:
+        return
+    port = os.environ.get("AREAL_DISK_WEIGHT_SSH_PORT", "22").strip()
+    timeout = float(os.environ.get("AREAL_DISK_WEIGHT_SYNC_TIMEOUT", "300"))
+    os.makedirs(meta.path, exist_ok=True)
+    ssh_command = (
+        f"ssh -p {int(port)} -o BatchMode=yes "
+        "-o StrictHostKeyChecking=no -o UserKnownHostsFile=/dev/null"
+    )
+    logger.info("Staging disk weights from %s:%s", source, meta.path)
+    subprocess.run(
+        [
+            "rsync",
+            "-a",
+            "--partial",
+            "-e",
+            ssh_command,
+            f"{source}:{meta.path.rstrip('/')}/",
+            f"{meta.path.rstrip('/')}/",
+        ],
+        check=True,
+        timeout=timeout,
+    )
+    if meta.use_lora and not all(os.path.isfile(path) for path in required):
+        raise FileNotFoundError(
+            f"staged LoRA adapter is incomplete at {meta.path}: {required}"
+        )
+
+
+def _stage_initial_lora_modules_from_ssh(server_args: dict[str, Any]) -> None:
+    """Stage vLLM's startup adapters before the server tries to load them.
+
+    Disk weight updates are staged after the actor publishes a new version, but
+    the initial adapter is passed directly in ``--lora-modules`` during server
+    startup.  On a cluster without shared storage that path must be mirrored
+    before vLLM starts, otherwise its first ``add_lora`` call fails.
+    """
+    modules = server_args.get("lora_modules") or []
+    for module in modules:
+        if not isinstance(module, str) or "=" not in module:
+            continue
+        _name, path = module.split("=", 1)
+        if not path:
+            continue
+        _stage_disk_weights_from_ssh(
+            WeightUpdateMeta(type="disk", path=path, use_lora=True)
+        )
