 RESULT_IPC_ENV = "AREAL_AWEX_RESULT_IPC"
 
+_QWEN35_DIRECT_ATTN_LORA_PATTERN = re.compile(
+    r"^model\.layers\.\d+\.(?:qkv_proj|o_proj)$"
+)
+
+
+def _qwen35_family_lora_hidden_dim(text_config: Any, module_name: str) -> tuple[int, int]:
+    """Return LoRA dimensions for the Qwen3.5 implementation used by Qwen3.6."""
+    hidden_size = int(text_config.hidden_size)
+    num_attention_heads = int(text_config.num_attention_heads)
+    num_key_value_heads = int(text_config.num_key_value_heads)
+    head_dim = int(
+        getattr(text_config, "head_dim", hidden_size // num_attention_heads)
+    )
+
+    if module_name == "qkv_proj":
+        # Qwen3.6's q_proj jointly emits query and attention-output gate values.
+        q_multiplier = 2 if getattr(text_config, "attn_output_gate", False) else 1
+        output_size = head_dim * (
+            num_attention_heads * q_multiplier + 2 * num_key_value_heads
+        )
+        return hidden_size, output_size
+    if module_name == "o_proj":
+        return head_dim * num_attention_heads, hidden_size
+    if module_name == "gate_up_proj":
+        return hidden_size, int(text_config.intermediate_size) * 2
+    if module_name == "down_proj":
+        return int(text_config.intermediate_size), hidden_size
+    if module_name == "embed_tokens":
+        return int(text_config.vocab_size), hidden_size
+    if module_name == "lm_head":
+        return hidden_size, int(text_config.vocab_size)
+    raise NotImplementedError(f"Qwen3.6 LoRA dimensions are unknown for {module_name}")
+
+
+def _enable_nested_text_config_lora_compat() -> None:
+    """Let SGLang LoRA consume composite configs used by Qwen3.6.
+
+    SGLang's LoRA manager expects language-model fields (``vocab_size``,
+    ``hidden_size``, and ``num_hidden_layers``) on the top-level HF config.
+    Composite configs keep those fields under ``text_config``.  Preserve the
+    composite config for the model runner, but pass its text config while the
+    LoRA manager is constructed.  The same compatibility layer supplies the
+    gated-Q dimensions that SGLang's generic fallback cannot infer.
+
+    Qwen3.6 currently reuses the Qwen3.5 implementation in Transformers and
+    SGLang.  Its full-attention layer stores ``qkv_proj`` and ``o_proj``
+    directly below ``model.layers.N``.  The inherited multimodal LoRA filter
+    only accepts an extra ``self_attn`` component, so those modules are not
+    wrapped and their TP weights are never sharded.  Extend the filter only
+    while constructing the LoRA manager; the existing SGLang LoRA wrappers
+    then perform the normal row/column-parallel slicing.
+    """
+    from sglang.srt.model_executor.model_runner import ModelRunner
+
+    original = ModelRunner.init_lora_manager
+    if getattr(original, "_areal_nested_text_config_compat", False):
+        return
+
+    def init_lora_manager(model_runner):
+        hf_config = model_runner.model_config.hf_config
+        text_config = getattr(hf_config, "text_config", None)
+        if text_config is None or hasattr(hf_config, "vocab_size"):
+            return original(model_runner)
+
+        base_model = model_runner.model
+        original_filter = getattr(base_model, "should_apply_lora", None)
+        filter_extended = callable(original_filter)
+        if filter_extended:
+
+            def should_apply_lora(module_name):
+                return original_filter(module_name) or bool(
+                    _QWEN35_DIRECT_ATTN_LORA_PATTERN.match(module_name)
+                )
+
+            base_model.should_apply_lora = should_apply_lora
+
+        original_hidden_dim = getattr(base_model, "get_hidden_dim", None)
+        hidden_dim_extended = bool(getattr(text_config, "attn_output_gate", False))
+        if hidden_dim_extended:
+
+            def get_hidden_dim(module_name, layer_idx):
+                if module_name == "qkv_proj" or original_hidden_dim is None:
+                    return _qwen35_family_lora_hidden_dim(text_config, module_name)
+                return original_hidden_dim(module_name, layer_idx)
+
+            base_model.get_hidden_dim = get_hidden_dim
+
+        model_runner.model_config.hf_config = text_config
+        try:
+            return original(model_runner)
+        finally:
+            model_runner.model_config.hf_config = hf_config
+            if filter_extended:
+                base_model.should_apply_lora = original_filter
+            if hidden_dim_extended:
+                if original_hidden_dim is None:
+                    delattr(base_model, "get_hidden_dim")
+                else:
+                    base_model.get_hidden_dim = original_hidden_dim
+
+    init_lora_manager._areal_nested_text_config_compat = True
+    ModelRunner.init_lora_manager = init_lora_manager
+
 
