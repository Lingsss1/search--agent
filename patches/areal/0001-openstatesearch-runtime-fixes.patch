+    masked_values = torch.where(active_mask, values, 0.0)
+    if reduction == "token_mean":
+        return masked_values.sum() / normalization_mask.count_nonzero().clamp(min=1)
+    if reduction != "sequence_mean":
+        raise ValueError(f"unknown loss reduction: {reduction!r}")
+
+    if values.ndim == 1:
+        if cu_seqlens is None:
+            raise ValueError("cu_seqlens is required for packed sequence reduction")
+        lengths = (cu_seqlens[1:] - cu_seqlens[:-1]).to(device=values.device)
+        sequence_idx = torch.arange(
+            lengths.numel(), device=values.device
+        ).repeat_interleave(lengths)
+        sums = torch.zeros(
+            lengths.numel(), device=values.device, dtype=values.dtype
+        ).scatter_add_(0, sequence_idx, masked_values)
+        counts = torch.zeros(
+            lengths.numel(), device=values.device, dtype=torch.int64
+        ).scatter_add_(0, sequence_idx, normalization_mask.to(torch.int64))
+    elif values.ndim == 2:
